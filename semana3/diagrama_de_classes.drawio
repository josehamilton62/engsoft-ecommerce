        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass Usuario {\n  - nome: String\n  - email: String\n  - senhaHash: String\n  + autenticar(): Boolean\n}\n\nclass Cliente {\n  - paisDestino: String\n  - enderecoEntrega: String\n  + consultarRastreio(): String\n}\n\nclass Administrador {\n  - nivelAcesso: Integer\n  + alterarVisibilidadeProduto(): void\n}\n\nclass Produto {\n  - codigoBarras: String\n  - nome: String\n  - precoBase: Double\n  - estaAtivo: Boolean\n  + calcularIvaLocal(pais: String): Double\n}\n\nclass Carrinho {\n  - idSessao: String\n  - valorTotalItens: Double\n  - totalIva: Double\n  + adicionarProduto(produto: Produto, qtd: Integer): void\n  + calcularTotalFinal(): Double\n}\n\nclass Pedido {\n  - codigoRastreio: String\n  - statusLogistico: String\n  - dataCompra: Date\n  - opcaoEnvio: String\n  + atualizarStatus(novoStatus: String): void\n  + dispararReciboEmail(): void\n}\n\nclass FornecedorLogistico {\n  - nomeEmpresa: String\n  - apiEndpoint: String\n  + receberOrdemCompra(pedido: Pedido): Boolean\n}\n\nclass PagamentoGateway {\n  - idTransacao: String\n  - statusPagamento: String\n  + processarCartaoCriptografado(): Boolean\n}\n\nUsuario &lt;|-- Cliente\nUsuario &lt;|-- Administrador\n\nCliente \&quot;1\&quot; -- \&quot;1..*\&quot; Pedido : realiza &gt;\nCliente \&quot;1\&quot; -- \&quot;1\&quot; Carrinho : possui &gt;\n\nCarrinho \&quot;1\&quot; o-- \&quot;1..*\&quot; Produto : contem &gt;\nPedido \&quot;1\&quot; *-- \&quot;1..*\&quot; Produto : composto de &gt;\n\nPedido \&quot;1\&quot; -- \&quot;1\&quot; PagamentoGateway : processado por &gt;\nPedido \&quot;1\&quot; -- \&quot;1\&quot; FornecedorLogistico : encaminhado para &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gpXuktbBD2OCEBfAJSgz-33">
